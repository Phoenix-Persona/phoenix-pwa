{
  "name": "zuka",
  "description": "Uncensorable AI personas on Nostr — voices that outlive the activist.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm i --silent && vite",
    "build": "npm i --silent && vite build -l error && cp dist/index.html dist/404.html && echo 'Project built successfully!'",
    "test": "npm i --silent && npm run test:all",
    "test:unit": "tsc --noEmit && eslint --cache && vitest run --exclude 'test/integration/**' --reporter=dot --silent",
    "test:unit:ci": "tsc --noEmit && eslint --cache && mkdir -p test-results && vitest run --exclude 'test/integration/**' --reporter=dot --reporter=junit --outputFile.junit=test-results/unit.xml --silent",
    "test:integration": "vitest run test/integration --pool=forks --maxWorkers=1 --testTimeout=10000 --reporter=dot --silent",
    "test:integration:ci": "mkdir -p test-results && vitest run test/integration --pool=forks --maxWorkers=1 --testTimeout=10000 --reporter=dot --reporter=junit --outputFile.junit=test-results/integration.xml --silent",
    "test:all": "npm run test:unit && npm run test:integration && vite build -l error && cp dist/index.html dist/404.html && echo 'All tests passed!'",
    "test:ci": "npm run test:unit:ci && npm run test:integration:ci && vite build -l error && cp dist/index.html dist/404.html && echo 'All tests passed!'",
    "postinstall": "mkdir -p public/ffmpeg && cp -f node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.js node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.wasm public/ffmpeg/",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@breeztech/breez-sdk-spark": "^0.13.6",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@noble/hashes": "^2.0.1",
    "@nostrify/nostrify": "^0.52.0",
    "@nostrify/react": "^0.6.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@scure/bip39": "^2.2.0",
    "@tanstack/react-query": "^5.100.5",
    "@unhead/react": "^3.1.0",
    "buffer": "^6.0.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "nostr-tools": "^2.23.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.2.0",
    "unhead": "^3.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/ios": "^8.3.3",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.59.0",
    "@nostrify/types": "^0.37.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  }
}
